# Placeholder values only. Never put real secrets in this file or in Git.
# Local development needs none of these; production sets them in the host's environment.

# Core
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=rechoice.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://rechoice.example.com
# Keep the private-stage site out of search results; set 0 only at public launch. Not access control.
SITE_NOINDEX=1
DATABASE_URL=postgresql://user:password@db.example.com:5432/secondlook?sslmode=require
REDIS_URL=redis://redis.example.com:6379/0
CACHE_URL=redis://redis.example.com:6379/1
CELERY_TASK_ALWAYS_EAGER=0

# Behind the host's proxy; check how many proxies add X-Forwarded-For entries
TRUSTED_PROXY_COUNT=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
LOG_LEVEL=INFO

# Previews stay on the mock until the owner approves live mode and every line below is set
PREVIEW_PROVIDER=mock
PREVIEW_LIVE_APPROVAL=
YOUCAM_API_KEY=
PREVIEW_UNIT_CEILING=0
PREVIEW_DAILY_UNIT_CAP=0
PREVIEW_SESSION_UNIT_CAP=6
YOUCAM_BALANCE_FLOOR=
# Judges: a code for /judge (blank turns it off), their own daily units, and whether the public may run live previews
JUDGE_ACCESS_CODE=
JUDGE_DAILY_UNIT_CAP=0
PUBLIC_LIVE_PREVIEWS=1
# Recovery for previews whose worker task was lost
PREVIEW_STALL_SECONDS=60
PREVIEW_QUEUE_LIMIT_SECONDS=300

# "Fill in from my words": the store's rules unless the owner switches Claude on and sets every line below
# (docs/ai-assistant-plan.md). Also set a monthly spend limit on the key's workspace in the Claude Console.
ASSISTANT_PROVIDER=rules
ASSISTANT_MODEL=claude-haiku-5-5
ASSISTANT_APPROVAL=
ANTHROPIC_API_KEY=
ASSISTANT_DAILY_READS=0
ASSISTANT_SESSION_READS=5

# Photo uploads and rate limits
ALLOW_PHOTO_UPLOAD=0
UPLOAD_LIMIT_PER_SESSION=3
UPLOAD_LIMIT_PER_ADDRESS=10
SESSION_LIMIT_PER_ADDRESS=20
PREVIEW_REQUEST_LIMIT_PER_ADDRESS=30

# Private images: local disk, or a private S3-compatible bucket shared by web and worker (docs/deployment-plan.md).
# Outside debug with a separate worker, PRIVATE_STORAGE must be set; s3 needs every line below.
PRIVATE_STORAGE=s3
PRIVATE_STORAGE_BUCKET=
PRIVATE_STORAGE_ENDPOINT=https://t3.storageapi.dev
PRIVATE_STORAGE_REGION=auto
PRIVATE_STORAGE_ADDRESSING=virtual
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# A store's key for the retailer API (docs/retailer-api.md), at least 32 characters. Blank turns the API off.
RETAILER_API_KEY=

# Process sizing
WEB_CONCURRENCY=2
WORKER_CONCURRENCY=4

# New copilot / recorded-synthetic visual review; separate cumulative budget, default off.
EXCHANGE_AI_PROVIDER=off
EXCHANGE_AI_JUDGE_ONLY=1
EXCHANGE_AI_APPROVAL=
EXCHANGE_AI_MAX_USD=0
EXCHANGE_AI_DAILY_CALLS=0
EXCHANGE_AI_SESSION_CALLS=12
EXCHANGE_AI_MODEL=claude-haiku-5-5
VISUAL_REVIEW_MODEL=claude-sonnet-5-5
EXCHANGE_AI_TIMEOUT_SECONDS=10
